# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/classifiedhub"

# NextAuth Configuration
NEXTAUTH_SECRET="your-super-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Payment Gateway (PayHere for Sri Lanka)
PAYHERE_MERCHANT_ID="your-merchant-id"
PAYHERE_SECRET="your-payhere-secret"
PAYHERE_API_URL="https://www.payhere.lk/api"

# File Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token"

# Email Service (Resend)
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="noreply@classifiedhub.com"

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+94XXXXXXXXX"

# Redis (for caching and sessions)
REDIS_URL="redis://localhost:6379"

# Analytics (Google Analytics)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Social Login (Google)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Social Login (Facebook)
FACEBOOK_CLIENT_ID="your-facebook-client-id"
FACEBOOK_CLIENT_SECRET="your-facebook-client-secret"

# Web Push Notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"

# Security
JWT_SECRET="your-jwt-secret-key"
ENCRYPTION_KEY="your-32-character-encryption-key"

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Feature Flags
NEXT_PUBLIC_ENABLE_AUCTIONS=true
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_BOOST=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Development
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000" 